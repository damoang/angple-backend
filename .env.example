# =============================================================================
# Angple Backend — Environment Configuration
# =============================================================================
# Copy: cp .env.example .env
# Personal overrides: .env.local (higher priority, gitignored)
#
# Priority: OS env vars > .env.local > .env > config.{APP_ENV}.yaml
# =============================================================================

APP_ENV=local

# --- Database (required) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=damoang

# --- JWT (required) ---
JWT_SECRET=your-jwt-secret-key-change-me

# --- Cron (internal endpoints) ---
CRON_SECRET=your-cron-secret-key

# --- Redis (optional) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- CORS (optional) ---
# CORS_ALLOW_ORIGINS=http://localhost:3000

# --- OAuth2 Social Login (optional) ---
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_REDIRECT_URL=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=

# --- Elasticsearch (optional) ---
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# --- S3-Compatible Storage (optional) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# CDN_URL=

# =============================================================================
# 공개 수정 이력 (선택)
# =============================================================================
# 이력을 공개할 게시판(쉼표 구분). 비우면 claim 하나.
# PUBLIC_REVISION_BOARDS=claim
# 운영진 역할 계정 mb_id(쉼표 구분). 이 계정이 쓴 글·댓글은 이력을 공개하지 않는다.
# 사이트 관리자(mb_level>=10)와 게시판 bo_admin 은 설정 없이도 운영진으로 본다.
# PUBLIC_REVISION_STAFF_IDS=

# =============================================================================
# Docker Compose 전용 (docker-compose.dev.yml 에서 사용)
# Go 앱에서는 읽지 않음
# =============================================================================
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=angple_db
MYSQL_USER=angple_user
MYSQL_PASSWORD=angple_pass
