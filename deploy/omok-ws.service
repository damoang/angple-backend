[Unit]
Description=Damoang Omok WebSocket Server (실시간 오목 대전)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=angple
WorkingDirectory=/home/angple/omok-ws
# ⛔ 구 유닛(/home/damoang/go-services/omok/omok-ws.service)은 ExecStart 경로가
#    틀려 있었고(omok-server 가 한 단계 위로 잡힘) systemd 에 설치조차 안 돼
#    2025-11 이후 서비스가 죽어 있었다. nginx 프록시만 살아 있어 /omok-ws/ 는 502였다.
ExecStart=/home/angple/omok-ws/omok-ws
EnvironmentFile=/home/angple/omok-ws/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
